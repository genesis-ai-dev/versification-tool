POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=frvt
POSTGRES_USER=frvt
POSTGRES_PASSWORD=frvt
# DATABASE_URL=postgresql+psycopg2://frvt:frvt@localhost:5433/frvt
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=Admin123!
# Comma-separated path prefixes that skip Basic auth and the failed-auth limiter.
# Empty keeps every route gated. Prefix / opens every path (including the limiter).
BASIC_AUTH_PUBLIC_PATHS=
# Failed Basic attempts per client IP inside the window before 429. <= 0 disables 429s.
BASIC_AUTH_FAILURE_LIMIT=10
# Sliding window in seconds for the failed-auth limiter. <= 0 disables 429s.
BASIC_AUTH_FAILURE_WINDOW_SECONDS=60
# When true, key the limiter on the rightmost X-Forwarded-For hop. Enable only behind a trusted proxy.
TRUST_PROXY_HEADERS=false
MAX_UPLOAD_BYTES=52428800
LOG_LEVEL=DEBUG
RESOLVE_TRACE_PIVOTS=false
